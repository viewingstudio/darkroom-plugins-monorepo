{
  "name": "darkroom-plugins-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter dev dev",
    "build": "pnpm -r --filter './packages/*' build",
    "clean": "pnpm -r clean",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "publish": "pnpm -r --filter './packages/*' build && pnpm publish:payload-access && pnpm publish:payload-deploy-trigger",
    "publish:payload-access": "cd packages/payload-access && npm publish",
    "publish:payload-deploy-trigger": "cd packages/payload-deploy-trigger && npm publish"
  },
  "devDependencies": {
    "@payloadcms/eslint-config": "3.9.0",
    "eslint": "^9.23.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10"
  }
}
