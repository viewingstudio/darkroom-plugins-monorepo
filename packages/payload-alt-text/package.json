{
  "name": "@kurto/payload-alt-text",
  "version": "2.0.3",
  "description": "AI-generated alt text for Payload CMS uploads, powered by Gemini or Claude",
  "keywords": [
    "payload",
    "cms",
    "plugin",
    "typescript",
    "react",
    "alt-text",
    "accessibility",
    "a11y",
    "ai",
    "gemini",
    "anthropic",
    "claude",
    "seo"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kurto/viewingstudio-darkroom-plugins.git",
    "directory": "packages/payload-alt-text"
  },
  "license": "MIT",
  "author": "Kurt Overton",
  "sideEffects": [
    "*.scss",
    "*.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "import": "./dist/exports/types.js",
      "types": "./dist/exports/types.d.ts",
      "default": "./dist/exports/types.js"
    },
    "./client": {
      "import": "./dist/exports/client.js",
      "types": "./dist/exports/client.d.ts",
      "default": "./dist/exports/client.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm clean && pnpm copyfiles && pnpm build:swc && pnpm build:types",
    "build:swc": "swc ./src -d ./dist --strip-leading-paths --config-file .swcrc",
    "build:types": "tsc --emitDeclarationOnly --outDir dist --rootDir src",
    "clean": "rimraf dist && rimraf tsconfig.tsbuildinfo",
    "copyfiles": "copyfiles -u 1 \"src/**/*.{html,css,scss,ttf,woff,woff2,eot,svg,jpg,png,json}\" dist/",
    "lint": "eslint src",
    "lint:fix": "eslint --fix --ext .ts,.tsx src",
    "prepublishOnly": "pnpm clean && pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "@payloadcms/ui": "^3.74.0",
    "payload": "^3.74.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@payloadcms/ui": "catalog:",
    "@swc/cli": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "^4.1.10",
    "copyfiles": "catalog:",
    "payload": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
