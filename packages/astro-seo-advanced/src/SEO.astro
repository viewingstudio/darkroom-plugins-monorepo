---
import type { SEOProps } from './types.js'
import { buildTitle, resolveImage, absoluteUrl, validateSEOProps } from './utils.js'
import MetaTags from './MetaTags.astro'
import OpenGraph from './OpenGraph.astro'
import TwitterCard from './TwitterCard.astro'
import Robots from './Robots.astro'
import CanonicalUrl from './CanonicalUrl.astro'
import LanguageAlternates from './LanguageAlternates.astro'
import JsonLd from './JsonLd.astro'

interface Props extends SEOProps {}

const {
  meta: rawMeta,
  globalSettings,
  siteUrl = '',
  currentPath = '',
  doc,
  titleTemplate,
  titleDefault,
  ogType = 'website',
  locale,
  localeAlternates,
  languageAlternates,
  twitterCard,
  twitterSite,
  twitterCreator,
  robotsExtras,
  extend,
} = Astro.props

const seoWarnings = validateSEOProps({ meta: rawMeta, siteUrl, currentPath, titleDefault })

if (seoWarnings.length > 0 && import.meta.env.DEV) {
  seoWarnings.forEach((w) => console.warn(w))
}

const meta = (rawMeta && typeof rawMeta === 'object' ? rawMeta : {}) as NonNullable<
  SEOProps['meta']
>

const title = buildTitle({
  metaTitle: meta.title,
  titleTemplate,
  titleDefault,
  siteName: globalSettings?.siteName,
  separator: globalSettings?.titleSeparator,
  disableSiteName: meta.disableSiteName,
})

const description =
  meta.description ||
  globalSettings?.defaults?.fallbackDescription ||
  (undefined as string | undefined)

const image = resolveImage(meta.image, globalSettings?.defaults?.ogImage)

const canonicalUrl =
  meta.canonicalUrl ? absoluteUrl(siteUrl, meta.canonicalUrl) : absoluteUrl(siteUrl, currentPath)

const pageUrl = absoluteUrl(siteUrl, currentPath)

const isArticle = meta.structuredData?.schemaType === 'article'
const resolvedOgType = isArticle ? 'article' : ogType

const articlePublishedTime = isArticle ? meta.structuredData?.article?.publishDate : undefined

const articleAuthor = isArticle ? meta.structuredData?.article?.author : undefined

const jsonLdDoc = doc || { meta, title: meta.title }
---

{seoWarnings.length > 0 && <meta name="seo-warnings" content={seoWarnings.join(' | ')} />}
<MetaTags title={title} description={description} keywords={meta.keywords} />
<OpenGraph
  title={meta.title || titleDefault || ''}
  description={description}
  url={pageUrl}
  ogType={resolvedOgType}
  siteName={globalSettings?.siteName}
  locale={locale}
  localeAlternates={localeAlternates}
  image={image}
  articlePublishedTime={articlePublishedTime}
  articleAuthor={articleAuthor}
/>
<TwitterCard
  title={meta.title || titleDefault || ''}
  description={description}
  image={image}
  card={twitterCard}
  site={twitterSite}
  creator={twitterCreator}
/>
<Robots
  robotsMeta={meta.robotsMeta}
  globalNoindex={globalSettings?.indexing?.noindex}
  extras={robotsExtras}
/>
<CanonicalUrl url={canonicalUrl} />
{
  languageAlternates && languageAlternates.length > 0 && (
    <LanguageAlternates alternates={languageAlternates} />
  )
}
{jsonLdDoc && <JsonLd doc={jsonLdDoc} globalSettings={globalSettings} />}
{extend?.meta?.map((attrs) => <meta {...attrs} />)}
{extend?.link?.map((attrs) => <link {...attrs} />)}
