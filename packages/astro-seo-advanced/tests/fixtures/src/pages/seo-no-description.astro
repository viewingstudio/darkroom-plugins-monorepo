---
import { SEO } from '@kurto/astro-seo-advanced'

const meta = {
  title: 'Page Without Description',
}
---

<html>
  <head>
    <SEO
      meta={meta as any}
      siteUrl="https://example.com"
      currentPath="/no-description"
    />
  </head>
  <body>
    <p>SEO with no description</p>
  </body>
</html>
